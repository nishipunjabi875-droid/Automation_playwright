# Freshworks Messaging / Freshchat API Credentials
FRESHWORKS_DOMAIN=your-domain.freshchat.com/v2
FRESHWORKS_API_KEY=your_freshworks_api_bearer_token

# Export Configuration
# Filter date range in ISO format (YYYY-MM-DD), leave blank to fetch all
START_DATE=2026-01-01
END_DATE=2026-12-31

# Concurrency & Performance Settings
CONCURRENCY_LIMIT=5
MAX_RETRIES=5

# Optional: Set to true to download attachment files to local attachments/ folder
DOWNLOAD_ATTACHMENTS=true
OUTPUT_DIR=./output
